{
  "Comment": "Pipeline simplificado e robusto de IDP para o CrediFacil com Auditoria Granular e Roteamento Condicional de Score",
  "StartAt": "InvokeBDA",
  "States": {
    "InvokeBDA": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${BdaInvokerArn}",
        "Payload": {
          "package_id.$": "$.package_id",
          "user_id.$": "$.user_id",
          "bda_output_bucket.$": "$.bda_output_bucket",
          "task_token.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.bda_callback_result",
      "Next": "EvaluateConfidence",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "EvaluateConfidence": {
      "Type": "Task",
      "Resource": "${ConfidenceCheckerArn}",
      "ResultPath": "$",
      "Next": "CheckAuditStatus",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "CheckAuditStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.audit_status",
          "StringEquals": "NEEDS_REVISION",
          "Next": "EscalateToHumanReview"
        }
      ],
      "Default": "ListNovaDocuments"
    },
    "EscalateToHumanReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${EventBusName}",
            "Source": "credifacil.idp",
            "DetailType": "LowConfidenceFieldsDetected",
            "Detail": {
              "package_id.$": "$.package_id",
              "user_id.$": "$.user_id",
              "bda_output_bucket.$": "$.bda_output_bucket",
              "execute_score.$": "$.execute_score",
              "status_esteira": "NEEDS_REVISION",
              "total_failed_fields.$": "$.failed_fields_count",
              "failed_fields_metadata.$": "$.failed_fields_metadata",
              "task_token.$": "$$.Task.Token"
            }
          }
        ]
      },
      "ResultPath": "$.human_review_output",
      "Next": "ListNovaDocuments",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "ListNovaDocuments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NovaDocumentListerArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "OutputPath": "$.Payload",
      "Next": "StructureNovaDocumentsMap",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "StructureNovaDocumentsMap": {
      "Type": "Map",
      "MaxConcurrency": 5,
      "ItemsPath": "$.documentos_para_estruturar",
      "Parameters": {
        "package_id.$": "$.package_id",
        "user_id.$": "$.user_id",
        "execute_score.$": "$.execute_score",
        "bda_output_bucket.$": "$.bda_output_bucket",
        "nome_pdf_original.$": "$$.Map.Item.Value.nome_pdf_original",
        "s3_key_bda.$": "$$.Map.Item.Value.s3_key_bda"
      },
      "Iterator": {
        "StartAt": "StructureSingleDocumentItem",
        "States": {
          "StructureSingleDocumentItem": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${NovaStructurerArn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "Payload.$": "$.Payload"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "Bedrock.ThrottlingException",
                  "Lambda.Unknown",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 4,
                "BackoffRate": 2.0
              },
              {
                "ErrorEquals": [
                  "ModelErrorException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 2,
                "BackoffRate": 1.5,
                "Comment": "Observado em produção em 09/07/2026: 'Model produced invalid sequence as part of ToolUse'. Erro do lado do modelo, não de rate-limit — MaxAttempts baixo porque não há garantia de que uma nova tentativa resolva algo determinístico, mas o custo de tentar 1-2x é baixo comparado a perder o documento inteiro."
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error_context",
                "Next": "HandleSingleDocumentFailure"
              }
            ],
            "End": true
          },
          "HandleSingleDocumentFailure": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "nome_pdf_original.$": "$.nome_pdf_original",
              "error_cause.$": "$.error_context.Cause"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.map_results",
      "Next": "AggregateNovaBatch",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "AggregateNovaBatch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NovaBatchAggregatorArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "OutputPath": "$.Payload",
      "Next": "GenerateExcelReports",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "GenerateExcelReports": {
      "Type": "Map",
      "ItemsPath": "$.json_estruturado.documentos_analisados",
      "Parameters": {
        "package_id.$": "$.package_id",
        "bda_output_bucket.$": "$.bda_output_bucket",
        "arquivo_original.$": "$$.Map.Item.Value.arquivo_original",
        "s3_key_resultado.$": "$$.Map.Item.Value.s3_key_resultado"
      },
      "Iterator": {
        "StartAt": "InvokeExcelGenerator",
        "States": {
          "InvokeExcelGenerator": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${ExcelGeneratorArn}",
              "Payload.$": "$"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.excel_generation_results",
      "Next": "CheckScoreExecution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "CheckScoreExecution": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.execute_score",
          "BooleanEquals": true,
          "Next": "ConsolidateCustomer"
        }
      ],
      "Default": "WriteResult"
    },
    "ConsolidateCustomer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CustomerConsolidatorArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "OutputPath": "$.Payload",
      "Next": "GenerateConsolidatedExcel",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "GenerateConsolidatedExcel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ExcelGeneratorArn}",
        "Payload": {
          "package_id.$": "$.package_id",
          "bda_output_bucket.$": "$.bda_output_bucket",
          "arquivo_original": "customer_consolidated.pdf",
          "s3_key_resultado.$": "States.Format('results/clientes/{}/customer_consolidated.json', $.package_id)"
        }
      },
      "ResultPath": "$.consolidated_excel_result",
      "Next": "WriteResult",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "WriteResult": {
      "Type": "Task",
      "Resource": "${ResultWriterArn}",
      "Next": "NotifySuccess",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "${NotificationArn}",
      "End": true
    },
    "NotifyError": {
      "Type": "Task",
      "Resource": "${NotificationArn}",
      "End": true
    }
  }
}