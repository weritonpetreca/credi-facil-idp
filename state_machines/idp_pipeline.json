{
  "Comment": "Pipeline simplificado e robusto de IDP para o CrediFacil com Auditoria Granular e Roteamento Condicional de Score",
  "StartAt": "InvokeBDA",
  "States": {
    "InvokeBDA": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${BdaInvokerArn}",
        "Payload": {
          "package_id.$": "$.package_id",
          "user_id.$": "$.user_id",
          "bda_output_bucket.$": "$.bda_output_bucket",
          "task_token.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$",
      "Next": "EvaluateConfidence",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "EvaluateConfidence": {
      "Type": "Task",
      "Resource": "${ConfidenceCheckerArn}",
      "Next": "ListNovaDocuments",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "ListNovaDocuments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NovaDocumentListerArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "OutputPath": "$.Payload",
      "Next": "StructureNovaDocumentsMap",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "StructureNovaDocumentsMap": {
      "Type": "Map",
      "ItemsPath": "$.documentos_para_estruturar",
      "Parameters": {
        "package_id.$": "$.package_id",
        "user_id.$": "$.user_id",
        "execute_score.$": "$.execute_score",
        "bda_output_bucket.$": "$.bda_output_bucket",
        "nome_pdf_original.$": "$$.Map.Item.Value.nome_pdf_original",
        "s3_key_bda.$": "$$.Map.Item.Value.s3_key_bda"
      },
      "Iterator": {
        "StartAt": "StructureSingleDocumentItem",
        "States": {
          "StructureSingleDocumentItem": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${NovaStructurerArn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "Payload.$": "$.Payload"
            },
            "OutputPath": "$.Payload",
            "End": true
          }
        }
      },
      "ResultPath": "$.map_results",
      "Next": "AggregateNovaBatch",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "AggregateNovaBatch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NovaBatchAggregatorArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "OutputPath": "$.Payload",
      "Next": "GenerateExcelReports",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "GenerateExcelReports": {
      "Type": "Map",
      "ItemsPath": "$.json_estruturado.documentos_analisados",
      "Parameters": {
        "package_id.$": "$.package_id",
        "bda_output_bucket.$": "$.bda_output_bucket",
        "arquivo_original.$": "$$.Map.Item.Value.arquivo_original",
        "s3_key_resultado.$": "$$.Map.Item.Value.s3_key_resultado",
        "campos_extraidos.$": "$$.Map.Item.Value.campos_extraidos"
      },
      "Iterator": {
        "StartAt": "InvokeExcelGenerator",
        "States": {
          "InvokeExcelGenerator": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${ExcelGeneratorArn}",
              "Payload.$": "$"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.excel_generation_results",
      "Next": "CheckScoreExecution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "CheckScoreExecution": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.execute_score",
          "BooleanEquals": true,
          "Next": "ConsolidateCustomer"
        }
      ],
      "Default": "WriteResult"
    },
    "ConsolidateCustomer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CustomerConsolidatorArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "OutputPath": "$.Payload",
      "Next": "GenerateConsolidatedExcel",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "GenerateConsolidatedExcel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ExcelGeneratorArn}",
        "Payload": {
          "package_id.$": "$.package_id",
          "bda_output_bucket.$": "$.bda_output_bucket",
          "arquivo_original": "customer_consolidated.pdf",
          "s3_key_resultado.$": "States.Format('results/clientes/{}/customer_consolidated.json', $.package_id)"
        }
      },
      "ResultPath": "$.consolidated_excel_result",
      "Next": "WriteResult",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "WriteResult": {
      "Type": "Task",
      "Resource": "${ResultWriterArn}",
      "Next": "NotifySuccess",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyError",
          "ResultPath": "$.error"
        }
      ]
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "${NotificationArn}",
      "End": true
    },
    "NotifyError": {
      "Type": "Task",
      "Resource": "${NotificationArn}",
      "End": true
    }
  }
}